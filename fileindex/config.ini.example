[DEFAULT]
; Selects which app's Cypher queries, UBKG context, and ES document field names
; FileIndexingUtils binds at startup. Must be "hubmap" or "sennet".
APP=hubmap|sennet

[Local]
LOG_ID = dev
LOG_LEVEL = ERROR
; Options: DEBUG, INFO, WARNING, ERROR

[ElasticSearch]
ELASTIC_SEARCH_URL = http://elastic-search:8080
ELASTIC_SEARCH_PUBLIC_INDEX = sn_dev_public_files
ELASTIC_SEARCH_PRIVATE_INDEX = sn_dev_consortium_files

[Globus]
GLOBUS_GROUPS_TOKEN = changeme
GLOBUS_ROOT_ENDPOINT_FILEPATH = /root/directory/to/globus/data
GLOBUS_PUBLIC_ENDPOINT_FILEPATH = %(GLOBUS_ROOT_ENDPOINT_FILEPATH)s/public
GLOBUS_CONSORTIUM_ENDPOINT_FILEPATH = %(GLOBUS_ROOT_ENDPOINT_FILEPATH)s/consortium
GLOBUS_PROTECTED_ENDPOINT_FILEPATH = %(GLOBUS_ROOT_ENDPOINT_FILEPATH)s/protected

[Neo4J]
NEO4J_URI = bolt://sennet-neo4j-localhost:7687
NEO4J_USERNAME = neo4j
NEO4J_PASSWORD = changeme

[Service]
INGEST_API_URL = http://uuid-api:8080
UBKG_URL = http://ontology-api:8080
UUID_API_URL = http://uuid-api:8080

[Slack]
; Set to DISABLED to suppress all Slack notifications regardless of which style
; below is configured - e.g. during local development.
SLACK_NOTIFICATIONS = ENABLED

; Style 1 is used if SLACK_CHANNEL_TOKEN is populated. Otherwise, style 2 is used
; if SLACK_WEBHOOK_URL is populated. If neither is populated, notifications are
; silently skipped. A populated SLACK_WEBHOOK_URL that fails to post raises an
; error rather than failing silently - the caller decides whether to catch and
; log it (fileindex.py's main() does).

; Style 1: bot-token, posts to any channel in SLACK_SUPPORTED_CHANNELS, supports
; @mentions and enforces SLACK_MAX_MSG_LENGTH.
SLACK_CHANNEL_TOKEN =
SLACK_SUPPORTED_CHANNELS =
SLACK_NOTIFICATION_CHANNEL =
SLACK_MAX_MSG_LENGTH = 2048
SLACK_USER_ID_MENTIONS_ON_ERROR = {}

; Style 2: webhook, a single fixed destination, no channel routing, no auth header.
SLACK_WEBHOOK_URL =
